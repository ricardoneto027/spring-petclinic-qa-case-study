# Copiar para docker/.env e ajustar ao teu computador (o .env não vai para o Git).
# Caminho para o código do spring-petclinic-angular (usado pelo serviço frontend).
ANGULAR_DIR=/Users/<o-teu-utilizador>/spring-petclinic-angular

# Segurança da API: false (defeito) ou true
PETCLINIC_SECURITY_ENABLE=false
